<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <PreceptDef ParentName="FestivalBase">
    <defName>CS_CampfireStories</defName>
    <label>war song</label>
    <description>Gather around a lit campfire. One to three colonists take turns sharing a memory, from everyday moments to battles and absent friends.</description>
    <ritualPatternBase>CS_CampfireStories</ritualPatternBase>
    <allowDuplicates>false</allowDuplicates>
  </PreceptDef>
  <RitualPatternDef>
    <defName>CS_CampfireStories</defName>
    <shortDescOverride>war song</shortDescOverride>
    <descOverride>A fireside storytelling ritual. Nominate up to three storytellers, or leave the role empty for random selection.</descOverride>
    <iconPathOverride>UI/Icons/Rituals/RitualFestival</iconPathOverride>
    <alwaysStartAnytime>true</alwaysStartAnytime>
    <ritualOnlyForIdeoMembers>false</ritualOnlyForIdeoMembers>
    <ritualObligationTargetFilter>CS_Campfire</ritualObligationTargetFilter>
    <ritualBehavior>CS_Stories</ritualBehavior>
    <ritualOutcomeEffect>CS_Stories</ritualOutcomeEffect>
    <playsIdeoMusic>false</playsIdeoMusic>
  </RitualPatternDef>
  <RitualObligationTargetFilterDef>
    <defName>CS_Campfire</defName>
    <workerClass>CampfireStories.CampfireTarget</workerClass>
    <thingDefs><li>Campfire</li></thingDefs>
  </RitualObligationTargetFilterDef>
  <RitualBehaviorDef>
    <defName>CS_Stories</defName>
    <workerClass>CampfireStories.StoryBehavior</workerClass>
    <durationTicks>5000</durationTicks>
    <spectatorsLabel>listeners</spectatorsLabel>
    <spectatorGerund>listen</spectatorGerund>
    <roles>
      <li Class="RitualRoleColonist">
        <id>storyteller</id><label>storyteller (optional)</label><maxCount>3</maxCount>
        <required>false</required><allowOtherIdeos>true</allowOtherIdeos>
        <mustBeAbleToReachTarget>true</mustBeAbleToReachTarget>
      </li>
    </roles>
    <stages>
      <li>
        <defaultDuty>Spectate</defaultDuty>
        <spectateDistanceOverride>3~5</spectateDistanceOverride>
        <endTriggers><li Class="CampfireStories.StoryEnd"/></endTriggers>
        <failTriggers>
          <li Class="StageFailTrigger_TargetThingMissing"><desc>The campfire is missing.</desc></li>
          <li Class="StageFailTrigger_TargetNotLit"><desc>The campfire is not lit.</desc></li>
        </failTriggers>
      </li>
    </stages>
  </RitualBehaviorDef>
  <DutyDef>
    <defName>CS_TellStory</defName><hook>HighPriority</hook><socialModeMax>Off</socialModeMax>
    <thinkNode Class="ThinkNode_Priority"><subNodes>
      <li Class="JobGiver_GotoTravelDestination"><exactCell>true</exactCell><locomotionUrgency>Walk</locomotionUrgency></li>
      <li Class="CampfireStories.WaitByFire"/>
    </subNodes></thinkNode>
  </DutyDef>
  <RitualOutcomeEffectDef>
    <defName>CS_Stories</defName>
    <description>Ritual quality grants a mood memory lasting {MOODDAYS} days. Connection speed does not affect quality.</description>
    <workerClass>RitualOutcomeEffectWorker_FromQuality</workerClass>
    <allowAttachableOutcome>false</allowAttachableOutcome>
    <comps><li Class="RitualOutcomeComp_ParticipantCount">
      <label>participant count</label><curve><points><li>(1, 0.35)</li><li>(4, 0.65)</li><li>(8, 1)</li></points></curve>
    </li></comps>
    <outcomeChances>
      <li><label>Quiet</label><chance>0.2</chance><memory>CS_Quiet</memory><description>The {0} was a quiet evening by the fire.</description><positivityIndex>-1</positivityIndex></li>
      <li><label>Warm</label><chance>0.6</chance><memory>CS_Warm</memory><description>The {0} brought everyone a little closer.</description><positivityIndex>1</positivityIndex></li>
      <li><label>Unforgettable</label><chance>0.2</chance><memory>CS_Unforgettable</memory><description>The {0} became a story worth remembering.</description><positivityIndex>2</positivityIndex></li>
    </outcomeChances>
  </RitualOutcomeEffectDef>
  <ThoughtDef><defName>CS_Quiet</defName><thoughtClass>Thought_AttendedRitual</thoughtClass><durationDays>3</durationDays><stackLimit>1</stackLimit><stages><li><label>quiet campfire</label><description>A little quiet by the fire was welcome.</description><baseMoodEffect>1</baseMoodEffect></li></stages></ThoughtDef>
  <ThoughtDef><defName>CS_Warm</defName><thoughtClass>Thought_AttendedRitual</thoughtClass><durationDays>3</durationDays><stackLimit>1</stackLimit><stages><li><label>warm campfire stories</label><description>We shared a few stories and felt closer.</description><baseMoodEffect>5</baseMoodEffect></li></stages></ThoughtDef>
  <ThoughtDef><defName>CS_Unforgettable</defName><thoughtClass>Thought_AttendedRitual</thoughtClass><durationDays>3</durationDays><stackLimit>1</stackLimit><stages><li><label>unforgettable campfire stories</label><description>Those voices by the fire will stay with me.</description><baseMoodEffect>8</baseMoodEffect></li></stages></ThoughtDef>
</Defs>
